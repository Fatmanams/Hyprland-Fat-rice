  {
    "label": "Repo: Theme contract (lint-themes)",
    "command": "bash scripts/lint.sh themes",
    "use_new_terminal": false,
    "reveal": "always",
    "save": "all"
  },
  {
    "label": "Repo: C++ syntax",
    "command": "bash scripts/lint.sh cpp",
    "use_new_terminal": false,
    "reveal": "always",
    "save": "all"
  },
  {
    "label": "Repo: Diff check",
    "command": "git diff --check",
    "use_new_terminal": false,
    "reveal": "always",
    "save": "all"
