# Editor / IDE
*.swp
*.swo
*~
\#*\#
.\#*

# Emacs byte-compiled output (CI byte-compiles init.el as a syntax check)
*.elc

# Local pacman cache and build artifacts leftover from manual testing
*.pkg.tar.zst
*.pkg.tar.xz
*.log
*.tar.gz
*.tar.bz2
*.tar.zst

# pywal cache (machine-specific)
.cache/

# Locally-cloned AUR repos during script development
build/
build-aur/

# Compiled locally by 30-dotfiles.sh on every deploy (source is tracked)
config/rofi/keybind-menu

# Local mail/calendar credentials and account settings
config/neomutt/accounts/*.muttrc
!config/neomutt/accounts/*.muttrc.example
config/neomutt/oauth/
config/msmtp/config
config/isync/mbsyncrc
config/vdirsyncer/config
config/vdirsyncer/*token*

# Backups made by staged scripts (backup .config)
.config-backup-*/

# OS junk
.DS_Store
Thumbs.db
