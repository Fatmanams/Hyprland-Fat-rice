;; colors.el — pywal16 user template (like colors-rofi.rasi next to it).
;; Rendered by `wal -i` into ~/.cache/wal/colors.el, loaded by
;; config/emacs/init.el. Variable names mirror the colors-wal.vim
;; template so the two editors share one palette vocabulary.
(setq wal-background "{background}")
(setq wal-foreground "{foreground}")
(setq wal-cursor "{cursor}")
(setq wal-color0 "{color0}")
(setq wal-color1 "{color1}")
(setq wal-color2 "{color2}")
(setq wal-color3 "{color3}")
(setq wal-color4 "{color4}")
(setq wal-color5 "{color5}")
(setq wal-color6 "{color6}")
(setq wal-color7 "{color7}")
(setq wal-color8 "{color8}")
(setq wal-color9 "{color9}")
(setq wal-color10 "{color10}")
(setq wal-color11 "{color11}")
(setq wal-color12 "{color12}")
(setq wal-color13 "{color13}")
(setq wal-color14 "{color14}")
(setq wal-color15 "{color15}")
