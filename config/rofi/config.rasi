// rofi config.rasi — launcher. Uses pywal16 colors via @import.
// Colors come from ~/.cache/wal/colors-rofi.rasi, generated by `wal` from
// the custom user template this repo ships at
// ~/.config/wal/templates/colors-rofi.rasi (raw @colorN scheme, deliberately
// NOT the stock colors-rofi-dark.rasi whose semantic names don't match this
// design). Regenerated by the `wal -i <wallpaper>` exec-once in
// hyprland.conf. If colors look wrong, run
// `wal -i ~/.config/hypr/wallpaper.jpg` and restart rofi (it'll re-read
// this file on next launch — no daemon to restart).
configuration {
    modi: "drun,run,window";
    font: "JetBrainsMono Nerd Font 12";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    terminal: "ghostty";
    drun-display-format: "{name}";
    window-format: "{w} · {c}";
    location: 0;
    lines: 10;
    columns: 1;
    width: 600px;
    height: 60%;
    padding: 24;
    layout: vertical;
    line-margin: 8;
    line-padding: 8;
    separator-style: none;
    border: 0;
    border-radius: 12;
    scrollbar: false;
    matching: "fuzzy";
    sorting-method: "fuzzy";
    hide-scrollbar: true;
    cycle: true;
}

// Import pywal vars (custom pywal user template): @background, @color0..15, @foreground
@import "../../.cache/wal/colors-rofi.rasi"

@theme "/dev/null"

* {
    background: transparent;
}

window {
    background: @background;
    border: 1px solid @color1;
    border-radius: 12px;
    padding: 20px;
}

mainbox {
    spacing: 12px;
    children: [inputbar, listview];
}

inputbar {
    spacing: 8px;
    padding: 12px 14px;
    border: 0 solid @color4;
    border-bottom-width: 1px;
    background: @background;
    text-color: @color2;
}

prompt {
    text-color: @color3;
    font-weight: bold;
}

entry {
    placeholder: "Type to search…";
    placeholder-color: @color8;
    text-color: @foreground;
}

listview {
    columns: 1;
    lines: 12;
    spacing: 4px;
    cycle: true;
    dynamic: true;
    layout: vertical;
}

element {
    padding: 10px 12px;
    border-radius: 6px;
    background: transparent;
    text-color: @foreground;
    orientation: horizontal;
}

element selected {
    background: @color1;
    text-color: @background;
}

element-icon {
    size: 24px;
    margin: 0 12px 0 0;
}

element-text {
    vertical-align: 0.5;
}

message {
    padding: 12px;
    background: @color4;
    border-radius: 8px;
    text-color: @background;
}

error-message {
    padding: 12px;
    background: @color1;
    text-color: @background;
    border-radius: 8px;
}
