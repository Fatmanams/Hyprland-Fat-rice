set realname = "Your Name"
set from = "you@gmail.com"
set imap_user = "you@gmail.com"
set folder = "imaps://imap.gmail.com/"
set smtp_url = "smtps://you@gmail.com@smtp.gmail.com"
set imap_authenticators = "oauthbearer:xoauth2"
set imap_oauth_refresh_command = "~/.config/neomutt/oauth/mutt_oauth2.py ~/.config/neomutt/oauth/gmail.token"
set smtp_authenticators = "oauthbearer:xoauth2"
set smtp_oauth_refresh_command = "~/.config/neomutt/oauth/mutt_oauth2.py ~/.config/neomutt/oauth/gmail.token"
