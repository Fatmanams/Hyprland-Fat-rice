{
    // waybar config — top bar, single-monitor layout. pywal16 ships colors
    // to ~/.cache/wal/colors-waybar.css via the `wal -i` exec-once in
    // hyprland.conf; style.css @import's that. To change colors: swap the
    // wallpaper, re-run `wal -i <path>`, killall waybar, restart waybar.
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 4,
    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["pulseaudio", "network", "cpu", "memory", "battery", "clock", "tray"],
    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "format-icons": {
            "1": "I",
            "2": "II",
            "3": "III",
            "4": "IV",
            "5": "V",
            "6": "VI",
            "7": "VII",
            "8": "VIII",
            "9": "IX",
            "10": "X",
            "default": "•"
        }
    },
    "hyprland/window": {
        "format": "{}",
        "max-length": 50,
        "rewrite": {
            "(.*) - Ghostty": " $1",
            "(.*) - Firefox": " $1",
            "(.*) - Steam": " $1"
        }
    },
    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-muted": "ﱝ muted",
        "format-icons": {
            "headphone": "",
            "default": ["", "", ""]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "network": {
        "format-wifi": " {essid} ({signalStrength}%)",
        "format-ethernet": " {ipaddr}/{cidr}",
        "format-disconnected": " disconnected",
        "tooltip-format": "{ifname} {ipaddr}/{cidr} via {gwaddr}"
    },
    "cpu": {
        "format": " {usage}%",
        "tooltip": false
    },
    "memory": {
        "format": " {percentage}%"
    },
    "battery": {
        "format": "{icon} {capacity}%",
        "format-icons": ["", "", "", "", "", "", "", "", "", ""],
        "format-charging": " {capacity}%",
        "states": {
            "warning": 30,
            "critical": 15
        }
    },
    "clock": {
        "format": " {:%Y-%m-%d  %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },
    "tray": {
        "spacing": 8
    }
}
